---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/posts';
import { withBase } from '../lib/url';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
  large?: boolean;
  priority?: boolean;
}

const { post, index = 1, large = false, priority = false } = Astro.props;
const href = withBase(`/blog/${post.id}/`);
const tags = post.data.tags.slice(0, 3);
const cover = post.data.cover ? withBase(post.data.cover) : undefined;
const minutes = readingTime(post.body ?? '');
---

<article class:list={['post-card', { 'post-card--large': large }]}>
  <div class="post-card__media">
    {
      cover ? (
        <img
          src={cover}
          alt={post.data.coverAlt ?? ''}
          width="1600"
          height="900"
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <div class="post-card__placeholder" aria-hidden="true">
          <span>{String(index).padStart(2, '0')}</span>
        </div>
      )
    }
    <span class="post-card__index" aria-hidden="true">{String(index).padStart(2, '0')}</span>
    <span class="post-card__glow" aria-hidden="true"></span>
  </div>

  <div class="post-card__body">
    <div class="post-card__meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span aria-hidden="true">/</span>
      <span>{minutes} MIN READ</span>
    </div>

    <h3 class="post-card__title">
      <a href={href}>{post.data.title}</a>
    </h3>

    <p class="post-card__desc">{post.data.description}</p>

    <div class="post-card__foot">
      <ul class="post-card__tags" aria-label="标签">
        {tags.map((tag) => <li>#{tag}</li>)}
      </ul>
      <a class="post-card__arrow" href={href} aria-label={`阅读《${post.data.title}》`}>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>