---
---

<button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="切换深色 / 浅色主题" title="切换主题">
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = 'roject-theme';
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  const sync = (theme: 'dark' | 'light') => {
    document.documentElement.dataset.theme = theme;
    const meta = document.getElementById('theme-color');
    meta?.setAttribute('content', theme === 'light' ? '#f2efe6' : '#08080b');
    toggle?.setAttribute('aria-label', theme === 'light' ? '切换到深色主题' : '切换到浅色主题');
    toggle?.setAttribute('title', theme === 'light' ? '切换到深色主题' : '切换到浅色主题');
  };

  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    sync(next);
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      /* 隐私模式下忽略 */
    }
  });

  sync((document.documentElement.dataset.theme as 'dark' | 'light') || 'dark');
</script>