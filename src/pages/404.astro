---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="404 · 信号丢失" description="页面不存在。" noindex>
  <section class="error-page">
    <div class="shell">
      <p class="eyebrow" style="justify-content:center">
        <span class="status-dot"></span>
        ERROR // SIGNAL LOST
      </p>
      <div class="error-code" data-text="404">404</div>
      <h1>信号丢失</h1>
      <p>你访问的页面不存在，或者已经被移动到别的地方。可以回到首页，或者搜索一下你想看的内容。</p>
      <div class="hero__actions" style="justify-content:center">
        <a class="btn btn--primary" href={withBase('/')}>返回首页</a>
        <a class="btn btn--ghost" href={withBase('/search/')}>搜索内容</a>
      </div>
    </div>
  </section>
</BaseLayout>